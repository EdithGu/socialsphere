# Elasticsearch (stores users + posts, backs search)
ES_URL=http://localhost:9200
ES_USERNAME=elastic
ES_PASSWORD=changeme

# Google Cloud Storage bucket for uploaded media
GCS_BUCKET=your-gcs-bucket-name

# Secret used to sign/verify JWT auth tokens - set a real random value
# outside local development
JWT_SECRET=dev-only-change-me

# OpenAI (used server-side to call DALL-E 3 — never sent to the frontend)
OPENAI_API_KEY=your_openai_api_key
